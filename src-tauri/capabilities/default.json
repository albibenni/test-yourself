{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "store:default",
    "stronghold:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "obsidian://*"
        }
      ]
    },
    "os:default"
  ]
}
